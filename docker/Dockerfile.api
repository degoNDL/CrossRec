FROM python:3.12-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY api/ api/
COPY ai/ ai/
COPY data/ data/
COPY optimizer/ optimizer/

# O Render (e a maioria dos PaaS) injeta PORT em runtime; 8000 é só o default
# para rodar localmente
# (`docker run -p 8000:8000 ...`) sem precisar passar a variável.
ENV PORT=8000
EXPOSE 8000

CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT}
